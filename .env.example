PORT=2567

# Guest-dev only (ignored for roles when Supabase is configured)
KLASE_OWNER_NAME=Hakkai
KLASE_ADMIN_NAMES=

# Server (Colyseus / Render). Leave empty to keep guest-only.
# Google OAuth client ID/secret are configured in the Supabase dashboard, not here.
# The service-role key is a SECRET: server only, never a VITE_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Owner = who may use /admin "God mode" and promote/demote. Set at least one.
# The email is only trusted when the provider verified it (Google does), and is matched case-insensitively.
# TODO: after your first Google sign-in, copy your user id (Supabase -> Authentication -> Users -> UID),
# set KLASE_OWNER_USER_ID, then remove KLASE_OWNER_EMAIL. The id can't be changed by changing an email.
KLASE_OWNER_USER_ID=
KLASE_OWNER_EMAIL=

# Client (Vite). Same project URL + anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_COLYSEUS_URL=ws://localhost:2567
# Optional. Derived from VITE_COLYSEUS_URL if empty (ws → http).
VITE_API_URL=
